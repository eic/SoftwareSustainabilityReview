{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eic/SoftwareSustainabilityReview/schema/assessment.schema.json",
  "title": "Sustainability assessment of one project in one review pass",
  "type": "object",
  "required": ["schema_version", "project", "pass", "commit", "assessor", "summary", "criteria"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "pass": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(-\\d+)?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "assessor": {
      "type": "object",
      "required": ["agent", "model"],
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 800 },
    "criteria": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["level", "confidence", "rationale", "evidence", "gaps", "actions"],
      "additionalProperties": false,
      "properties": {
        "level": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
        "not_applicable": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 600 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    },
    "action": {
      "type": "object",
      "required": ["action", "priority", "effort"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "minLength": 1, "maxLength": 400 },
        "priority": { "enum": ["high", "medium", "low"] },
        "effort": { "enum": ["S", "M", "L"] }
      }
    }
  }
}
